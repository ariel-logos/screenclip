<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blurb"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_overlay"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <Button
            android:id="@+id/grant_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_overlay" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_a11y"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:text="@string/a11y_explainer"
            android:textSize="13sp" />

        <Button
            android:id="@+id/enable_a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_a11y" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_tile"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:text="@string/tile_note"
            android:textSize="13sp" />

        <Button
            android:id="@+id/add_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_tile" />

        <Button
            android:id="@+id/remove_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remove_tile" />

        <Button
            android:id="@+id/capture_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/capture" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.6"
            android:text="@string/reachable_later"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
