<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#1B5E8C"
        android:pathData="M0,0h108v108h-108z" />

    <!--
      Crop marks, scaled to span 86.4 of the 108 canvas: 24 * 3.6 = 86.4, centred by
      (108 - 86.4) / 2 = 10.8. The bigger the glyph, the bigger the square it encloses,
      which is the only room the bunny has.
    -->
    <group
        android:scaleX="3.6"
        android:scaleY="3.6"
        android:translateX="10.8"
        android:translateY="10.8">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M17,15h2V7c0,-1.1 -0.9,-2 -2,-2H9v2h8V15zM7,17V1H5v4H1v2h4v10c0,1.1 0.9,2 2,2h10v4h2v-4h4v-2H7z" />
    </group>

    <!--
      The bunny sits in the enclosed square, which now runs 36..72 on both axes.
      Drawn in its own 100x100 space so the silhouette stays in round numbers:
      final = local * 0.38 + (35, 37.28), which centres it on (54, 54) at roughly
      30 units tall inside a 36-unit square.
    -->
    <group
        android:scaleX="0.38"
        android:scaleY="0.38"
        android:translateX="35"
        android:translateY="37.28">
        <!-- Left ear -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M27,26 a9,22 0 1,0 18,0 a9,22 0 1,0 -18,0" />
        <!-- Right ear -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M55,26 a9,22 0 1,0 18,0 a9,22 0 1,0 -18,0" />
        <!-- Head -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M28,62 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0" />
    </group>
</vector>
